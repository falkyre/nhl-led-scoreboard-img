{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "auto",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": ": "
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "host",
            "key": "Host"
        },
        {
            "type": "kernel",
            "key": "Kernel",
            "format": "{1} {2}" // Matches neofetch shorthand="on"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "packages",
            "key": "Packages"
        },
        {
            "type": "shell",
            "key": "Shell"
        },
        {
            "type": "display",
            "key": "Resolution",
            "compactType": "original" // Matches neofetch refresh_rate="off"
        },
        {
            "type": "icons",
            "key": "Icons"
        },
        {
            "type": "terminal",
            "key": "Terminal"
        },
        {
            "type": "terminalfont",
            "key": "Terminal Font"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "temp": true, // cpu_temp="C"
            "showPeCoreCount": true
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "memory",
            "key": "Memory"
        },
        {
            "type": "cpuusage",
            "key": "CPU Usage"
        },
        {
            "type": "disk",
            "key": "Disk",
            "folders": ["/"]
        },
        {
            "type": "localip",
            "key": "Local IP",
            "showIpv6": false,
            "showMac": false
        },
        {
            "type": "locale",
            "key": "Locale"
        },
        {
            "type": "command",
            "key": "Time Zone",
            "text": "timedatectl show -p Timezone --value"
        },
        "break",
        // Custom: NHL LED Scoreboard Image
        {
            "type": "command",
            "key": "NHL LED Scoreboard Image",
            "keyColor": "yellow",
            // Neofetch: bold, color 10 (bright green)
            "text": "echo \"\u001b[1m\u001b[92m$(cat /home/pi/.nhlledportal/imgver)\u001b[0m\"",
            "shell": "/bin/bash"
        },
        // Custom: NHL LED Scoreboard Status with Logic
        {
            "type": "command",
            "key": "NHL LED Scoreboard",
            "keyColor": "yellow",
            // Logic: if status contains UPDATE, bold+green+reverse, else cyan
            "text": "status=$(cat /home/pi/.nhlledportal/status); if [[ $status == *\"UPDATE\"* ]]; then echo \"\u001b[1m\u001b[92m\u001b[7m $status \u001b[27m\u001b[0m\"; else echo \"\u001b[36m $status\u001b[0m\"; fi",
            "shell": "/bin/bash"
        },
        "break",
        // Custom: Scoreboard Commands Header
        {
            "type": "custom",
            "format": "\u001b[33m\u001b[4mscoreboard commands:\u001b[0m" // Yellow + Underline
        },
        {
            "type": "custom",
            "format": "\u001b[1msb-help sb-tools sb-issue sb-updatecheck sb-changelog sb-upgrade sb-resetwifi\u001b[0m" // Bold
        },
        {
            "type": "custom",
            "format": "\u001b[1msb-stderr sb-stdout sb-livelog sb-stop sb-start sb-restart sb-status sb-sysinfo\u001b[0m" // Bold
        },
        "break",
        // Custom: Useful Links
        {
            "type": "custom",
            "format": "\u001b[33m\u001b[4mUseful links:\u001b[0m" // Yellow + Underline
        },
        {
            "type": "command",
            "key": "NLS ControlHub",
            // Neofetch: color 2 (green) for URL. Extracts IP from wlan0.
            "text": "ip=$(ip -4 addr show wlan0 | grep -oP '(?<=inet\\s)\\d+(\\.\\d+){3}'); echo \"\u001b[32mhttp://$ip:8000\u001b[0m\"",
            "shell": "/bin/bash"
        }
    ]
}